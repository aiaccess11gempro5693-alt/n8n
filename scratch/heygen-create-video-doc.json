          x-cli-default: auto
          x-mcp-default: auto
        fit:
          anyOf:
            - $ref: '#/components/schemas/AvatarFit'
            - type: 'null'
          default: null
          description: >-
            How the subject is fitted to the output canvas. 'cover' scales to
