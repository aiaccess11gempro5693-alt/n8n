          title: Folder Id
        resolution:
          anyOf:
            - $ref: '#/components/schemas/VideoResolution'
            - type: 'null'
          default: null
          description: Output video resolution.
        aspect_ratio:
          anyOf:
            - $ref: '#/components/schemas/VideoAspectRatio'
            - type: 'null'
          default: '16:9'
          description: >-
            Output video aspect ratio. Supported values: '16:9', '9:16', '4:5',
