paths:
  /v3/videos:
    post:
      tags:
        - Videos
      summary: Create Video
      description: >-
        Creates a video from a HeyGen avatar or an arbitrary image. Supports
        scripts or pre-recorded audio for lip-sync. Supports the Avatar III,
