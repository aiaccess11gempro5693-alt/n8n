{
 "subs": [
  {
   "text": "ДЕНЬ 1 ИЗ 30: САША ВЫЛЕЗАЕТ ИЗ_ДОЛГОВ",
   "t0": 0.0,
   "t1": 7.099999904632568
  },
  {
   "text": "Три кредитки",
   "t0": 7.099999904632568,
   "t1": 7.7799999713897705
  },
  {
   "text": "кредит на телефон",
   "t0": 7.7799999713897705,
   "t1": 8.819999694824219
  },
  {
   "text": "и микрозайм",
   "t0": 8.819999694824219,
   "t1": 9.579999923706055
  },
  {
   "text": "о котором я",
   "t0": 9.579999923706055,
   "t1": 10.199999809265137
  },
  {
   "text": "стараюсь не думать.",
   "t0": 10.199999809265137,
   "t1": 11.619999885559082
  },
  {
   "text": "Даю себе тридцать дней",
   "t0": 11.619999885559082,
   "t1": 12.979999542236328
  },
  {
   "text": "чтобы всё это разгрести.",
   "t0": 12.979999542236328,
   "t1": 14.800000190734863
  },
  {
   "text": "И решать за меня",
   "t0": 14.800000190734863,
   "t1": 15.84000015258789
  },
  {
   "text": "будете вы.",
   "t0": 15.84000015258789,
   "t1": 18.059999465942383
  },
  {
   "text": "День первый.",
   "t0": 18.059999465942383,
   "t1": 19.200000762939453
  },
  {
   "text": "Шаг первый",
   "t0": 19.200000762939453,
   "t1": 20.18000030517578
  },
  {
   "text": "без паники.",
   "t0": 20.18000030517578,
   "t1": 21.360000610351562
  },
  {
   "text": "Выписываю все долги",
   "t0": 21.360000610351562,
   "t1": 22.260000228881836
  },
  {
   "text": "в один список",
   "t0": 22.260000228881836,
   "t1": 23.639999389648438
  },
  {
   "text": "сколько должен",
   "t0": 23.639999389648438,
   "t1": 24.399999618530273
  },
  {
   "text": "под какой процент",
   "t0": 24.399999618530273,
   "t1": 25.34000015258789
  },
  {
   "text": "и когда платить.",
   "t0": 25.34000015258789,
   "t1": 26.239999771118164
  },
  {
   "text": "Ого…",
   "t0": 26.239999771118164,
   "t1": 28.0
  },
  {
   "text": "Микрозайм самый маленький",
   "t0": 28.0,
   "t1": 29.739999771118164
  },
  {
   "text": "но самый дорогой.",
   "t0": 29.739999771118164,
   "t1": 31.479999542236328
  },
  {
   "text": "Значит, гасить его первым.",
   "t0": 31.479999542236328,
   "t1": 33.29999923706055
  },
  {
   "text": "И тут…",
   "t0": 33.29999923706055,
   "t1": 33.86000061035156
  },
  {
   "text": "уведомление!",
   "t0": 33.86000061035156,
   "t1": 36.380001068115234
  },
  {
   "text": "Наушники",
   "t0": 36.380001068115234,
   "t1": 36.7400016784668
  },
  {
   "text": "минус сорок процентов",
   "t0": 36.7400016784668,
   "t1": 38.58000183105469
  },
  {
   "text": "рассрочка без",
   "t0": 38.58000183105469,
   "t1": 39.41999816894531
  },
  {
   "text": "переплаты!",
   "t0": 39.41999816894531,
   "t1": 40.779998779296875
  },
  {
   "text": "Ну вы поняли.",
   "t0": 40.779998779296875,
   "t1": 41.97999954223633
  },
  {
   "text": "Выбирайте",
   "t0": 41.97999954223633,
   "t1": 42.68000030517578
  },
  {
   "text": "что я сделаю завтра.",
   "t0": 42.68000030517578,
   "t1": 44.279998779296875
  },
  {
   "text": "Вариант А",
   "t0": 44.279998779296875,
   "t1": 45.15999984741211
  },
  {
   "text": "беру наушники в рассрочку",
   "t0": 45.15999984741211,
   "t1": 46.97999954223633
  },
  {
   "text": "это же всего две",
   "t0": 46.97999954223633,
   "t1": 47.84000015258789
  },
  {
   "text": "тысячи в месяц.",
   "t0": 47.84000015258789,
   "t1": 49.58000183105469
  },
  {
   "text": "Вариант Б",
   "t0": 49.58000183105469,
   "t1": 50.380001068115234
  },
  {
   "text": "откладываю эти деньги",
   "t0": 50.380001068115234,
   "t1": 51.34000015258789
  },
  {
   "text": "и гашу ими микрозайм.",
   "t0": 51.34000015258789,
   "t1": 53.0
  },
  {
   "text": "Пишите в комментариях",
   "t0": 53.0,
   "t1": 54.65999984741211
  },
  {
   "text": "А или Б.",
   "t0": 54.65999984741211,
   "t1": 56.040000915527344
  },
  {
   "text": "Что выберете",
   "t0": 56.040000915527344,
   "t1": 56.97999954223633
  },
  {
   "text": "то и будет.",
   "t0": 56.97999954223633,
   "t1": 58.220001220703125
  },
  {
   "text": "Только честно.",
   "t0": 58.220001220703125,
   "t1": 59.41999969482422
  }
 ],
