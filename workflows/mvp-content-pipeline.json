        },
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000002",
      "name": "1. Ввод данных",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"claude-opus-5\",\n  max_tokens: 4096,\n  system: \"Ты помощник, который готовит короткий видео-сценарий: текст озвучки и список текстовых промптов для генерации картинок к каждой сцене. Отвечай СТРОГО валидным JSON без пояснений, точно по схеме.\",\n  messages: [\n    { role: \"user\", content: `Тема: ${$json.topic}. Стиль/формат: ${$json.style}. Нужно ${$json.num_images} картинок (промптов), по одному предложению текста озвучки на каждую картинку в среднем.` }\n  ],\n  output_config: {\n    format: {\n      type: \"json_schema\",\n      schema: {\n        type: \"object\",\n        properties: {\n          voiceover_text: { type: \"string\", description: \"Полный текст озвучки, который будет прочитан целиком\" },\n          image_prompts: { type: \"array\", items: { type: \"string\" }, description: \"Промпты для генерации картинок, на английском языке, детальные\" }\n        },\n        required: [\"voiceover_text\", \"image_prompts\"],\n        additionalProperties: false\n      }\n    }\n  }\n}) }}",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000003",
      "name": "2. Сценарий + промпты (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst textBlock = raw.content && raw.content.find(b => b.type === 'text');\nif (!textBlock) {\n  throw new Error('В ответе Claude не найден text-блок. Полный ответ: ' + JSON.stringify(raw));\n}\nconst parsed = JSON.parse(textBlock.text);\nreturn [{ json: parsed }];"
      },
      "id": "a1000000-0000-0000-0000-000000000004",
      "name": "3. Разобрать JSON от Claude",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.elevenlabs.io/v1/text-to-speech/21m00Tcm4TlvDq8ikWAM",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.voiceover_text, model_id: \"eleven_multilingual_v2\" }) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "audio"
            }
          }
        }
      },
      "id": "a1000000-0000-0000-0000-000000000005",
      "name": "4. Озвучка (ElevenLabs)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 160],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "ElevenLabs API"
        }
      }
    },
    {
      "parameters": {
        "content": "**Voice ID по умолчанию:** 21m00Tcm4TlvDq8ikWAM (готовый голос \"Rachel\", можно поменять на свой из ElevenLabs → Voice Library → Copy Voice ID и вставить в URL этой ноды.",
        "height": 140,
        "width": 260
      },
      "id": "a1000000-0000-0000-0000-000000000098",
      "name": "Sticky Note: Voice ID",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [900, -20]
    },
    {
      "parameters": {
        "fieldToSplitOut": "image_prompts",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000006",
      "name": "5. Разбить промпты картинок",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [900, 440]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-image:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [ { parts: [ { text: $json.image_prompts } ] } ] }) }}",
        "options": {}
      },
      "id": "a1000000-0000-0000-0000-000000000007",
      "name": "6. Картинка (Gemini / Nano Banana)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 440],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Google AI Studio"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst parts = item.candidates?.[0]?.content?.parts || [];\nconst imgPart = parts.find(p => p.inlineData && p.inlineData.data);\nif (!imgPart) {\n  throw new Error('Gemini не вернул изображение. Ответ: ' + JSON.stringify(item));\n}\nconst buffer = Buffer.from(imgPart.inlineData.data, 'base64');\nconst mimeType = imgPart.inlineData.mimeType || 'image/png';\nreturn [{\n  json: {},\n  binary: {\n    image: await this.helpers.prepareBinaryData(buffer, 'image.png', mimeType)\n  }\n}];"
      },
      "id": "a1000000-0000-0000-0000-000000000008",
      "name": "7. Base64 → файл изображения",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1340, 440]
    }
